{
  "name": "@nosmai/react-native-agora-bridge",
  "version": "0.1.0",
  "description": "Publish a Nosmai-filtered camera feed to Agora from React Native: GL textures on Android, CVPixelBuffers on iOS, pushed straight into react-native-agora's engine.",
  "main": "lib/module/index.js",
  "types": "lib/typescript/src/index.d.ts",
  "react-native": "src/index.tsx",
  "source": "src/index.tsx",
  "exports": {
    ".": {
      "source": "./src/index.tsx",
      "types": "./lib/typescript/src/index.d.ts",
      "default": "./lib/module/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "lib",
    "android",
    "ios",
    "cpp",
    "scripts",
    "docs",
    "tools",
    "CONTRIBUTING.md",
    "CONTRACT.md",
    "CHANGELOG.md",
    "*.podspec",
    "README.md",
    "LICENSE",
    "!**/__tests__",
    "!**/.*",
    "!android/build",
    "!android/.gradle",
    "!android/.cxx",
    "!android/local.properties",
    "!android/**/libs/*.aar",
    "!ios/build"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "eslint \"**/*.{js,ts,tsx}\"",
    "clean": "del-cli lib",
    "prepare": "bob build",
    "package:check": "node scripts/package-check.js",
    "example:typecheck": "tsc -p example/tsconfig.json --noEmit",
    "validate": "yarn typecheck && yarn example:typecheck && yarn lint && yarn prepare && yarn package:check",
    "check": "yarn validate"
  },
  "keywords": [
    "react-native",
    "agora",
    "nosmai",
    "ar",
    "beauty",
    "filters",
    "video",
    "live-streaming"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nosmai/nosmai_agora_bridge_react_native.git"
  },
  "author": "Nosmai <admin@nosmai.com>",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20.19.4"
  },
  "peerDependencies": {
    "@nosmai/react-native-effects-sdk": ">=1.0.0",
    "react": ">=19.1.0 <20",
    "react-native": ">=0.81.5 <0.82.0",
    "react-native-agora": ">=4.6.2 <4.7.0"
  },
  "devDependencies": {
    "@react-native/eslint-config": "0.81.5",
    "@types/react": "^19.1.0",
    "del-cli": "^7.0.0",
    "eslint": "^8.57.1",
    "prettier": "^3.8.3",
    "react": "19.1.0",
    "react-native": "0.81.5",
    "react-native-agora": "4.6.4",
    "react-native-builder-bob": "^0.43.0",
    "typescript": "^5.9.0"
  },
  "codegenConfig": {
    "name": "RNNosmaiAgoraBridgeSpec",
    "type": "modules",
    "jsSrcsDir": "src",
    "android": {
      "javaPackageName": "com.nosmai.agorabridge"
    }
  },
  "react-native-builder-bob": {
    "source": "src",
    "output": "lib",
    "targets": [
      [
        "module",
        {
          "esm": true
        }
      ],
      [
        "typescript",
        {
          "project": "tsconfig.build.json"
        }
      ]
    ]
  },
  "packageManager": "yarn@4.11.0+sha512.4e54aeace9141df2f0177c266b05ec50dc044638157dae128c471ba65994ac802122d7ab35bcd9e81641228b7dcf24867d28e750e0bcae8a05277d600008ad54"
}
